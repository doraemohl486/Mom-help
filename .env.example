# 서버
PORT=3000
# 외부(Twilio 등)에서 접근 가능한 이 서버의 주소. 전화 연동 시 필요
PUBLIC_BASE_URL=https://example.ngrok.app
DB_PATH=data/app.db

# AI 비서 (없으면 규칙 기반 비서로 동작)
ANTHROPIC_API_KEY=

# 주소·장소 찾기 (모두 무료)
# 오픈스트리트맵: 키 없이 동작 (1초에 1번, '검색' 버튼을 눌렀을 때만). 연락처를 꼭 적어 주세요
GEOCODER_CONTACT=           # 예: you@example.com
NOMINATIM_URL=https://nominatim.openstreetmap.org   # off 로 끌 수 있음
# 브이월드(국토교통부) 무료 키가 있으면 도로명·지번 주소 위치가 더 정확해져요
VWORLD_API_KEY=

# 경로 비교 (없으면 직선거리 기반 추정치 사용)
KAKAO_REST_API_KEY=   # 카카오모빌리티 길찾기(자동차/택시요금)
ODSAY_API_KEY=        # ODsay 대중교통 길찾기

# 전화 제공자: simulator(기본, 가상 콜센터) | twilio
CALL_PROVIDER=simulator
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# AI가 걸 번호 (동행 온다콜택시 전용번호)
TAXI_CENTER_NUMBER=+8218550120

# 문자 알림 (없으면 앱 내 알림 + 서버 로그만)
SMS_PROVIDER=log
